# Generate private laptop credentials with: python3 scripts/dev_env.py
DOMAIN_KG_MONGO_URI=mongodb://127.0.0.1:27027/?replicaSet=rs0&directConnection=true
DOMAIN_KG_NEO4J_URI=bolt://127.0.0.1:27687
DOMAIN_KG_NEO4J_USER=neo4j
DOMAIN_KG_NEO4J_PASSWORD=generate-with-scripts-dev-env
DOMAIN_KG_QDRANT_URL=http://127.0.0.1:26333
DOMAIN_KG_QDRANT_API_KEY=generate-with-scripts-dev-env
DOMAIN_KG_S3_ENDPOINT=http://127.0.0.1:29000
DOMAIN_KG_S3_ACCESS_KEY=domain-kg-dev
DOMAIN_KG_S3_SECRET_KEY=generate-with-scripts-dev-env
DOMAIN_KG_PUBLIC_URL=http://127.0.0.1:8000
DOMAIN_KG_OIDC_ISSUER=http://127.0.0.1:18080/realms/domain-kg
DOMAIN_KG_OIDC_CLIENT_ID=
DOMAIN_KG_OIDC_CLIENT_SECRET=
DOMAIN_KG_MONGO_DATABASE=domain_kg
# Optional bounded server policy; defaults are in config/retention.example.json.
DOMAIN_KG_RETENTION_CONFIG=config/retention.example.json
DOMAIN_KG_RESTORE_CLEANUP_CONFIG=config/restore-cleanup.example.json
# Global parser policy. Use a private writable copy to enable Advanced settings edits.
DOMAIN_KG_PARSER_CONFIG=config/parser.example.json
